rules_version = '2';
// 학생(로그인 없음): 신고서 "제출"만 가능, 읽기·수정 불가
// 교사(아래 이메일로 로그인): 조회·확인서 작성·삭제 가능
service cloud.firestore {
  match /databases/{db}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'TEACHER_EMAIL';
    }
    function str(v, n) { return v is string && v.size() <= n; }

    match /reports/{rid} {
      allow create: if request.resource.data.keys().hasOnly(
            ['status', 'detail', 'grade', 'cls', 'num', 'name', 'start', 'sp', 'end', 'ep', 'days', 'pcount', 'reason', 'wdate', 'sname', 'pname',
             'sigS', 'sigP', 'fileCount', 'code', 'state', 'confirm', 'opinion', 'submitted'])
        && request.resource.data.status in ['질병', '인정', '기타']
        && request.resource.data.detail is list && request.resource.data.detail.size() <= 4
        && str(request.resource.data.grade, 2) && str(request.resource.data.cls, 2)
        && str(request.resource.data.num, 3) && str(request.resource.data.name, 20)
        && str(request.resource.data.start, 10) && str(request.resource.data.end, 10)
        && str(request.resource.data.sp, 2) && str(request.resource.data.ep, 2) && str(request.resource.data.pcount, 3)
        && str(request.resource.data.days, 3) && str(request.resource.data.reason, 120)
        && str(request.resource.data.wdate, 10) && str(request.resource.data.pname, 20)
        && str(request.resource.data.sname, 20)
        && str(request.resource.data.sigS, 60000) && str(request.resource.data.sigP, 60000)
        && request.resource.data.fileCount is int && request.resource.data.fileCount <= 3
        && request.resource.data.state == '접수' && (request.resource.data.confirm == null || request.resource.data.confirm is map)
        && (!('opinion' in request.resource.data) || request.resource.data.opinion == null || request.resource.data.opinion is map)
        && request.resource.data.submitted == request.time;
      allow read, update, delete: if isTeacher();

      match /files/{fid} {
        allow create: if fid in ['0', '1', '2']
          && exists(/databases/$(db)/documents/reports/$(rid))
          && request.resource.data.keys().hasOnly(['dataUrl'])
          && str(request.resource.data.dataUrl, 1000000);
        allow read, delete: if isTeacher();
      }
    }

    // 교외체험학습 신청서·결과보고서: 학생은 제출만, 담임만 조회·통보서 작성·삭제
    match /trips/{tid} {
      allow create: if request.resource.data.kind in ['apply', 'report', 'sheet']
        && request.resource.data.keys().hasOnly(
            ['kind', 'name', 'grade', 'cls', 'num', 'start', 'end', 'days', 'form', 'wdate', 'pname', 'sname', 'sigP', 'sigS',
             'phone', 'rule', 'dest', 'lodging', 'gname', 'grel', 'gphone', 'lname', 'lrel', 'lphone', 'purpose', 'plan',
             'place', 'title', 'body', 'fileCount', 'code', 'state', 'notice', 'submitted'])
        && str(request.resource.data.name, 20) && str(request.resource.data.grade, 2) && str(request.resource.data.cls, 2)
        && (!('sigP' in request.resource.data) || str(request.resource.data.sigP, 60000))
        && (!('plan' in request.resource.data) || str(request.resource.data.plan, 400))
        && (!('body' in request.resource.data) || str(request.resource.data.body, 4000))
        && (!('sigS' in request.resource.data) || str(request.resource.data.sigS, 60000))
        && (!('fileCount' in request.resource.data) || (request.resource.data.fileCount is int && request.resource.data.fileCount <= 4))
        && request.resource.data.state == '접수' && request.resource.data.notice == null
        && request.resource.data.submitted == request.time;
      allow read, update, delete: if isTeacher();

      // 별지 사진 (장당 1MB 이하, 최대 4장)
      match /files/{fid} {
        allow create: if fid in ['0', '1', '2', '3']
          && exists(/databases/$(db)/documents/trips/$(tid))
          && request.resource.data.keys().hasOnly(['dataUrl'])
          && str(request.resource.data.dataUrl, 1000000);
        allow read, delete: if isTeacher();
      }
    }

    match /settings/{doc} {
      allow read, write: if isTeacher();
    }
  }
}
